# /etc/default/datakom-exporter - configuration of datakom-exporter.service
# Every variable mirrors a command line option, see: datakom-exporter --help

# Controller address (required)
DATAKOM_HOST=
#DATAKOM_PORT=502
#DATAKOM_UNIT_ID=1

# 32-bit word order: low_first (confirmed on D-300 MK3) or high_first (500-MODBUS manual).
# Check a new controller with: datakom-exporter probe --host <ip>
#DATAKOM_WORD_ORDER=low_first

# Per-request timeout and pymodbus retries. Replies take ~0.12 s in the LAN; a lost reply costs
# timeout x (retries + 1) before the exporter reconnects and repeats the request once.
#DATAKOM_TIMEOUT=2
#DATAKOM_RETRIES=1
# Pause between the block requests of one poll, if the controller needs it
#DATAKOM_REQUEST_DELAY=0

# Polling groups and their intervals in seconds (0 = every scrape). Groups that are not
# listed are never read from the controller and not exported.
#   genset    genset (alternator) V/I/kW/PF per phase and total, kVA, Hz
#   engine    battery, charge input, oil pressure, oil and coolant temperature, fuel, rpm,
#             digital inputs (raw), operation status, mode, state timer
#   mains     mains V/I/kW/PF per phase and total, kVA, Hz (I/kW/kVA are 0 with CTs on the alternator)
#   flags     function flags: mains fail, contactors, auto ready, alarm summary, ...
#   alarms    shutdown / loaddump / warning tables; with flags on, read only while an alarm is
#             active (every 60 s, and at once when the alarm summary changes)
#   counters  engine hours, runs, cranks, on-load events, kWh, hours to service, battery at the
#             last cranking
#   info      device identity and versions
#   extended  L-L voltages, reactive power, kVArh, hours/days since service, days to service,
#             mains kVAr and kWh
# genset + engine + mains + flags share blocks: 8 requests per scrape. "live" (up to 0.3.x) was
# split into genset and engine.
#DATAKOM_GROUPS=genset=0,engine=0,mains=0,flags=0,alarms=60,counters=300,info=3600

# HTTP listen address for /metrics
#DATAKOM_LISTEN=:9725
# Scrapes reuse a poll result for this many seconds, counted from the end of the poll. Below the
# scrape interval it only merges concurrent scrapes (HA pair, scrapes queued behind a slow poll);
# above it the controller is polled less often than Prometheus scrapes.
#DATAKOM_CACHE_TTL=10

#DATAKOM_LOG_LEVEL=WARNING
