# /etc/default/datakom-exporter - configuration of datakom-exporter.service
# Every variable mirrors a command line option, see: datakom-exporter --help

# Controller address (required)
DATAKOM_HOST=
#DATAKOM_PORT=502
#DATAKOM_UNIT_ID=1

# 32-bit word order: low_first (confirmed on D-300 MK3) or high_first (500-MODBUS manual).
# Check a new controller with: datakom-exporter probe --host <ip>
#DATAKOM_WORD_ORDER=low_first

# Per-request timeout and pymodbus retries
#DATAKOM_TIMEOUT=2
#DATAKOM_RETRIES=1
# Pause between the block requests of one poll, if the controller needs it
#DATAKOM_REQUEST_DELAY=0

# Polling groups and their intervals in seconds (0 = every scrape). Groups that are not
# listed are never read from the controller and not exported.
#   live      genset V/I/kW (per phase and total)/kVA/PF/Hz, battery, charge input, oil pressure, oil and coolant
#             temperature, fuel, rpm, status, mode
#   alarms    shutdown / loaddump / warning tables
#   counters  engine hours, runs, cranks, on-load events, kWh, hours to service
#   info      device identity and versions
#   mains     mains V/I/kW (per phase and total)/kVA/PF/Hz
#   extended  L-L voltages, reactive power, kVArh, hours/days since service, days to service
#DATAKOM_GROUPS=live=0,mains=0,alarms=60,counters=300,info=3600

# HTTP listen address for /metrics
#DATAKOM_LISTEN=:9725
# Scrapes within this many seconds reuse the previous poll (protects the controller
# when several Prometheus servers scrape the exporter)
#DATAKOM_MIN_POLL_INTERVAL=5

#DATAKOM_LOG_LEVEL=WARNING
